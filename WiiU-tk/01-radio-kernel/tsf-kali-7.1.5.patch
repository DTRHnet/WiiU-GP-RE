+/*
+ * DRC patch: export the Wi-Fi Time Synchronization Function (TSF) to
+ * userland as a raw little-endian u64 at /sys/class/net/<iface>/tsf.
+ *
+ * libdrc needs the access point's hardware clock to stamp video frames so the
+ * Wii U GamePad can schedule playback; stock Linux never exposes it. Original
+ * patch by Pierre Bourdon (delroth), 2013, ported forward to 7.1.5.
+ *
+ * Fragile by design: reading this attribute may add the interface to the
+ * driver if it is not in it yet.
+ */
+static ssize_t tsf_show(struct device *dev, struct device_attribute *attr,
+			char *buf)
+{
+	struct net_device *ndev;
+	struct ieee80211_sub_if_data *sdata;
+	int need_remove = -1;
+	u64 output;
+
+	ndev = container_of(dev, struct net_device, dev);
+	if (!ndev)
+		return -EIO;
+
+	sdata = IEEE80211_DEV_TO_SUB_IF(ndev);
+	if (!sdata)
+		return -EIO;
+
+	if ((sdata->flags & IEEE80211_SDATA_IN_DRIVER) == 0) {
+		need_remove = drv_add_interface(sdata->local, sdata);
+		if (need_remove != 0)
+			return -EIO;
+	}
+
+	output = drv_get_tsf(sdata->local, sdata);
+
+	if (need_remove == 0) /* the add above was needed and succeeded */
+		drv_remove_interface(sdata->local, sdata);
+
+	memcpy(buf, &output, sizeof(output));
+	return sizeof(output);
+}
+static DEVICE_ATTR_RO(tsf);
