+++ b/libdrc-vnc/libdrc-thefloppydriver/include/drc/internal/idr-policy.h
@@ -0,0 +1,101 @@
+// Keyframe (IDR) policy for the DRC link.
+//
+// The problem this solves, measured: the GamePad sends a 4-byte datagram
+// 01 00 00 00 once per frame EVEN WHEN THE PICTURE IS PERFECT - it is a
+// heartbeat, not a fault signal (wozt/libdrc 291aed6a8c noted 58/s while a
+// synthetic demo decoded cleanly). libdrc treats every one as "send me a
+// keyframe", so each frame becomes an IDR.
+//
+// Cost, measured on this host (research/CODEC-SPEC.md 2.2):
+//   normal desktop stream ...... 0.29 Mbps
+//   every frame an IDR ......... 8.57 Mbps   (17.8 kB/frame, 28x)
+// That cannot fit the link, so the pad loses more, asks more, and the picture
+// never recovers. The loop is broken by treating the message as liveness.
+//
+// Policy implemented here:
+//   * IDR on the first frame of a stream;
+//   * a proactive IDR every kProactiveIdrFrames frames (bounded self-healing);
+//   * a request-driven IDR only when the request cadence CHANGES - i.e. it
+//     arrives while the previous request was a long time ago - which is what a
+//     real "I lost the picture" request looks like;
+//   * one format-only slot after every IDR, so no P frame is sent while the
+//     receiver is still recovering (console behaviour: format+IDR, format only,
+//     format+P => a 2 x 16.683 ms IDR-to-P step).
+//
+// Pure code, no clocks: callers pass timestamps. tests/scheduler_test.cpp runs it.
+#ifndef DRC_INTERNAL_IDR_POLICY_H_
+#define DRC_INTERNAL_IDR_POLICY_H_
+
+#include <drc/types.h>
+
+namespace drc {
+
+// Proactive IDR cadence. Barista uses 60 encoded frames; a 60-frame cadence
+// costs ~1 fps and one ~40 kB IDR per second on game content.
+const u32 kProactiveIdrFrames = 60;
+
+// A heartbeat arriving sooner than this after the previous one is cadence, not
+// distress. At 59.94 fps a heartbeat lands every ~16.7 ms.
+const u32 kRequestDebounceUs = 50000;  // 50 ms ~= 3 frames
+
+enum class IdrDecision {
+  kNone,        // send a normal P frame
+  kIdr,         // send an IDR frame
+  kFormatOnly,  // send only the 32-byte format message this slot
+};
+
+class IdrPolicy {
+ public:
+  // Returns what this frame slot should carry.
+  //   frame_index   frames encoded so far in this stream, starting at 0
+  //   requested     a 01 00 00 00 datagram arrived since the last call
+  //   now_us        caller's monotonic clock, microseconds
+  IdrDecision Decide(u64 frame_index, bool requested, u64 now_us) {
+    // Recovery slot: the frame right after an IDR carries only the format
+    // message, never video.
+    if (format_only_pending_) {
+      format_only_pending_ = false;
+      return IdrDecision::kFormatOnly;
+    }
+
+    const bool first = (frame_index == 0);
+    const bool proactive = frame_index != 0 &&
+                           (frame_index % kProactiveIdrFrames) == 0;
+
+    // Debounce: a request that repeats at heartbeat cadence is liveness.
+    bool real_request = false;
+    if (requested) {
+      if (!have_request_) {
+        real_request = true;
+      } else {
+        real_request = (now_us - last_request_us_) > kRequestDebounceUs;
+      }
+      last_request_us_ = now_us;
+      have_request_ = true;
+    }
+
+    if (first || proactive || real_request) {
+      format_only_pending_ = true;
+      return IdrDecision::kIdr;
+    }
+    return IdrDecision::kNone;
+  }
+
+  // Frames still owed a recovery slot (0 or 1). For logging/tests.
+  bool format_only_pending() const { return format_only_pending_; }
+
+  void Reset() {
+    format_only_pending_ = false;
+    have_request_ = false;
+    last_request_us_ = 0;
+  }
+
+ private:
+  bool format_only_pending_ = false;
+  bool have_request_ = false;
+  u64 last_request_us_ = 0;
+};
+
+}  // namespace drc
+
+#endif  // DRC_INTERNAL_IDR_POLICY_H_
diff --git a/libdrc-vnc/libdrc-thefloppydriver/include/drc/internal/video-packet-schedule.h b/libdrc-vnc/libdrc-thefloppydriver/include/drc/internal/video-packet-schedule.h
