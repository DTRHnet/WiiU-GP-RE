@@ -0,0 +1,67 @@
+// In-frame video packet scheduling for the DRC link.
+//
+// Why this exists: upstream libdrc sends every packet of a frame in one tight
+// loop. A healthy 5-chunk frame is ~5 datagrams, but an IDR is 25-40 kB, i.e.
+// 15-25 datagrams, all back to back. The real console spreads them across the
+// frame slot, and bursting is the documented cause of freezes and of decoder
+// desync (see research/CODEC-SPEC.md sections 1.4 and 3.5).
+//
+// The schedule below is measured from an authenticated real-console capture
+// (Barista's drc-media-packet-datasheet.md): chunk starts at 0/3/6/9/11 ms with
+// per-chunk completion deadlines at 2.5/5/7.5/10/13 ms. The first two chunks are
+// delivered early so the pad can start feeding its decoder; the spread avoids a
+// single large burst.
+//
+// Pure code, no sockets, no timers: tests/scheduler_test.cpp exercises it.
+#ifndef DRC_INTERNAL_VIDEO_PACKET_SCHEDULE_H_
+#define DRC_INTERNAL_VIDEO_PACKET_SCHEDULE_H_
+
+#include <cstddef>
+#include <drc/types.h>
+
+namespace drc {
+
+// One video frame slot at 59.94 Hz.
+const u32 kVideoFramePeriodUs = 16683;
+
+// Chunk start offsets within a frame, microseconds from frame start.
+const u32 kChunkStartUs[] = {0, 3000, 6000, 9000, 11000};
+// Final-packet deadline for each chunk, microseconds from frame start.
+const u32 kChunkDeadlineUs[] = {2500, 5000, 7500, 10000, 13000};
+
+const size_t kVideoChunksPerFrame = 5;
+
+// Microsecond offset, from frame start, at which packet `packet_index` of
+// `packet_count` in `chunk_index` should be sent.
+//
+// Multi-packet chunks are spread linearly across their window so that a 4 kB
+// chunk does not appear as an instantaneous burst. Single-packet chunks go out
+// at the window start.
+//
+// Returns 0 for out-of-range input rather than reading past the tables.
+inline u32 VideoPacketOffsetUs(size_t chunk_index, size_t packet_index,
+                               size_t packet_count) {
+  if (chunk_index >= kVideoChunksPerFrame) return 0;
+  const u32 start = kChunkStartUs[chunk_index];
+  const u32 end = kChunkDeadlineUs[chunk_index];
+  if (packet_count <= 1 || packet_count > 256) return start;
+  if (packet_index >= packet_count) return end;
+  const u32 span = end - start;
+  return start + (u32)((u64)span * packet_index / (packet_count - 1));
+}
+
+// True when a chunk must be split across several datagrams.
+inline bool ChunkNeedsSplitting(size_t chunk_size, size_t max_payload) {
+  return max_payload != 0 && chunk_size > max_payload;
+}
+
+// Number of datagrams a chunk occupies.
+inline size_t ChunkPacketCount(size_t chunk_size, size_t max_payload) {
+  if (max_payload == 0) return 0;
+  if (chunk_size == 0) return 0;
+  return (chunk_size + max_payload - 1) / max_payload;
+}
+
+}  // namespace drc
+
+#endif  // DRC_INTERNAL_VIDEO_PACKET_SCHEDULE_H_
