diff --git a/libdrc-vnc/libdrc-thefloppydriver/src/udp.cpp b/libdrc-vnc/libdrc-thefloppydriver/src/udp.cpp
index bef318c..83a33fe 100644
--- a/libdrc-vnc/libdrc-thefloppydriver/src/udp.cpp
+++ b/libdrc-vnc/libdrc-thefloppydriver/src/udp.cpp
@@ -79,6 +79,17 @@ bool UdpClient::Start() {
     return false;
   }
 
+  // Non-blocking: a UDP sendto() to an unreachable or unresolved peer (a pad
+  // that just vanished, a stale ARP entry, a radio that went away) can block a
+  // blocking socket for seconds while the kernel chases the neighbour. That
+  // wedges whatever thread is sending - measured here as a 2.5 s stall in the
+  // video sender, which also delayed shutdown. With O_NONBLOCK a send either
+  // leaves immediately or reports EAGAIN and the caller decides.
+  int flags = fcntl(sock_fd_, F_GETFL, 0);
+  if (flags != -1) {
+    fcntl(sock_fd_, F_SETFL, flags | O_NONBLOCK);
+  }
+
   return true;
 }
 
