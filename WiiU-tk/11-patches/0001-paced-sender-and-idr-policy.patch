+void VideoStreamer::SenderLoop() {
+  // Encoding lives here, not in the frame timer, so a slow IDR cannot push the
+  // cadence around (that was defect 2 in research/CODEC-SPEC.md 3.5).
+  bool vstrm_inited = false;
+  u16 vstrm_seqid = 0;
+  std::vector<VstrmPacket> packets;
+  AstrmPacket astrm_packet;
+
+  for (;;) {
+    std::vector<byte> frame;
+    std::vector<std::string> pre_chunks;
+    u32 timestamp = 0;
+    bool send_idr = false;
+    bool format_only = false;
+    u64 start_us = 0;
+    {
+      std::unique_lock<std::mutex> lk(send_mutex_);
+      send_cv_.wait(lk, [this] { return stop_sender_ || have_job_; });
+      if (stop_sender_) {
+        return;
+      }
+      frame = std::move(job_frame_);
+      pre_chunks = std::move(job_chunks_);
+      timestamp = job_timestamp_;
+      send_idr = job_send_idr_;
+      format_only = job_format_only_;
+      start_us = job_start_us_;
+      job_frame_.clear();
+      job_chunks_.clear();
+      have_job_ = false;
+    }
+
+    // The format message goes out at the frame slot start, before video.
+    GenerateAstrmPacket(&astrm_packet, timestamp);
+    astrm_client_->Send(astrm_packet.GetBytes(), astrm_packet.GetSize());
+
+    // Recovery slot: format only, no video, so no P frame is sent while the
+    // pad is still rebuilding its reference picture.
+    if (format_only) {
+      continue;
+    }
+
+    std::unique_ptr<H264ChunkArray> owned_chunks;
+    const H264ChunkArray* chunks = NULL;
+    if (!pre_chunks.empty()) {
+      owned_chunks = AsChunkArray(pre_chunks);
+      chunks = owned_chunks.get();
+    } else if (!frame.empty()) {
+      chunks = &encoder_->Encode(frame, send_idr);
+    }
+    if (chunks == NULL || chunks->empty()) {
+      continue;
+    }
+
+    const std::vector<u32> offsets = BuildPacketOffsets(*chunks);
+    packets.clear();
+    GenerateVstrmPackets(&packets, *chunks, timestamp, send_idr, &vstrm_inited,
+                         &vstrm_seqid, frame_rate_);
+
+    for (size_t i = 0; i < packets.size(); ++i) {
+      // Spread the frame's datagrams across the chunk windows instead of
+      // dumping them back to back. Overdue packets go out immediately.
+      u32 offset;
+      if (i < offsets.size()) {
+        offset = offsets[i];
+      } else {
+        offset = (u32)((u64)kVideoFramePeriodUs * i / packets.size());
+      }
+      // A shutdown request must not be delayed by the remaining pacing
+      // windows: the frame still goes out complete, just not spread.
+      const u64 due = stop_sender_
+                          ? 0
+                          : start_us + static_cast<u64>(offset);
+      for (;;) {
+        const u64 now = MonotonicNowUs();
+        if (now >= due) {
+          break;
+        }
+        const u64 remaining = due - now;
+        std::this_thread::sleep_for(std::chrono::microseconds(
+            remaining > 500 ? 400 : remaining));
+      }
+      if (!vstrm_client_->Send(packets[i].GetBytes(), packets[i].GetSize())) {
+        send_failures_++;
+      }
+      paced_packets_++;
+    }
+  }
+}
