+// Monotonic microseconds, used only for in-frame pacing (never for the media
+// timestamp, which must stay locked to the AP's TSF).
+u64 MonotonicNowUs() {
+  return (u64)std::chrono::duration_cast<std::chrono::microseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+// Per-packet send offsets for a frame, derived from the chunk sizes that
+// GenerateVstrmPackets is about to packetise. Falls back to an even spread
+// across the frame slot if the shape is unexpected.
+std::vector<u32> BuildPacketOffsets(const H264ChunkArray& chunks) {
+  std::vector<u32> offsets;
+  for (size_t c = 0; c < chunks.size(); ++c) {
+    const size_t chunk_size = std::get<1>(chunks[c]);
+    const size_t n = ChunkPacketCount(chunk_size, kMaxVstrmPayloadSize);
+    for (size_t i = 0; i < n; ++i) {
+      offsets.push_back(VideoPacketOffsetUs(c, i, n));
+    }
+  }
+  return offsets;
+}
