diff --git a/drc-x264/encoder/encoder.c b/drc-x264/encoder/encoder.c
index e6c27b9..25e9876 100644
--- a/drc-x264/encoder/encoder.c
+++ b/drc-x264/encoder/encoder.c
@@ -2880,7 +2880,16 @@ cont:
                 b_cabac_chunk_ending = 0;
             }
 
-            if( i_mb_y > 0 && (i_mb_y % 6) == 0 && i_mb_x == 0 )
+            /* DRH chunk boundary: arm ONE macroblock before the end of a 6-row
+             * group, because the flush above records the CURRENT mb_xy as the
+             * chunk's last MB. Arming at the start of the next group (the
+             * original code) made every boundary land 2 MBs late: measured
+             * i_first_mb = 0/326/650/974/1298 instead of the 0/324/648/972/1296
+             * that the pad implies (it gets no slice header and re-slices every
+             * 6 rows). Barista's working MiniH264 uses the 324MB grid
+             * (core/drh/encoder/x264/slice.h). See
+             * research/agents/encoder-conformance.md. */
+            if( (i_mb_y % 6) == 5 && i_mb_x == h->mb.i_mb_width - 2 )
                 b_cabac_chunk_ending = 1;
         }
 
