+// Copyright (c) 2013, Mema Hacking, All rights reserved.
+// See LICENSE for the full license text.
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <drc/internal/session-push.h>
+#include <drc/internal/udp.h>
+
+namespace drc {
+
+namespace {
+const char* kDefaultPath =
+    "/home/kali/Wiiu/out/evidence/truth/console-messages/session-push.bin";
+}  // namespace
+
+SessionPusher::SessionPusher(const std::string& dst_addr)
+    : client_(new UdpClient(dst_addr)) {}
+
+SessionPusher::~SessionPusher() {
+  Stop();
+}
+
+bool SessionPusher::Start() {
+  if (thread_.joinable()) {
+    return true;
+  }
+  if (!client_->Start(0, 0)) {
+    return false;
+  }
+  thread_ = std::thread(&SessionPusher::Loop, this);
+  return true;
+}
+
+void SessionPusher::Stop() {
+  stop_.store(true);
+  cv_.notify_all();
+  if (thread_.joinable()) {
+    thread_.join();
+  }
+  client_->Stop();
+}
+
+void SessionPusher::Kick() {
+  kick_.store(true);
+  cv_.notify_all();
+}
+
+bool SessionPusher::Load() {
+  if (loaded_) {
+    return !records_.empty();
+  }
+  loaded_ = true;
+  const char* env = getenv("DRC_SESSION_PUSH");
+  const char* path = (env && env[0]) ? env : kDefaultPath;
+  FILE* f = fopen(path, "rb");
+  if (!f) {
+    fprintf(stderr, "libdrc: session push file not found (%s)\n", path);
+    return false;
+  }
+  unsigned short count = 0;
+  if (fread(&count, sizeof(count), 1, f) != 1) {
+    fclose(f);
+    return false;
+  }
+  for (unsigned i = 0; i < count; ++i) {
+    u32 len = 0;
+    double rel = 0.0;
+    if (fread(&len, sizeof(len), 1, f) != 1 ||
+        fread(&rel, sizeof(rel), 1, f) != 1) {
+      break;
+    }
+    Record r;
+    r.rel = rel;
+    r.payload.resize(len);
+    if (len && fread(&r.payload[0], 1, len, f) != len) {
+      break;
+    }
+    records_.push_back(std::move(r));
+  }
+  fclose(f);
+  fprintf(stderr, "libdrc: session push loaded: %u records\n",
+          static_cast<unsigned>(records_.size()));
+  return !records_.empty();
+}
+
+void SessionPusher::Loop() {
+  std::unique_lock<std::mutex> lk(mutex_);
+  for (;;) {
+    cv_.wait(lk, [this] { return stop_.load() || kick_.load(); });
+    if (stop_.load()) {
+      return;
+    }
+    kick_.store(false);
+    if (!Load()) {
+      continue;
+    }
+    lk.unlock();
+    // Replay at the console's own cadence. The push is ~29 datagrams/s for 28 s;
+    // a whole run therefore lasts about that long and runs on this thread so it
+    // never delays video.
+    const auto t0 = std::chrono::steady_clock::now();
+    size_t i = 0;
+    for (const Record& r : records_) {
+      if (stop_.load()) {
+        break;
+      }
+      const auto due = t0 + std::chrono::microseconds(
+          static_cast<long long>(r.rel * 1e6));
+      std::this_thread::sleep_until(due);
+      client_->Send(r.payload.data(), r.payload.size());
+      ++i;
+      sent_.store(sent_.load() + 1);
+    }
+    fprintf(stderr, "libdrc: session push sent %u datagrams (%.1fs of console "
+                    "session state)\n",
+            static_cast<unsigned>(i), records_.empty() ? 0.0 : records_.back().rel);
+    lk.lock();
+  }
+}
+
+}  // namespace drc
