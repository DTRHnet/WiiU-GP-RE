diff --git a/drc-hostap/src/ap/ieee802_11_ht.c b/drc-hostap/src/ap/ieee802_11_ht.c
index 2d53648..000440d 100644
--- a/drc-hostap/src/ap/ieee802_11_ht.c
+++ b/drc-hostap/src/ap/ieee802_11_ht.c
@@ -39,8 +39,24 @@ u8 * hostapd_eid_ht_capabilities(struct hostapd_data *hapd, u8 *eid)
 
 	cap = (struct ieee80211_ht_capabilities *) pos;
 	os_memset(cap, 0, sizeof(*cap));
+#ifdef CONFIG_TENDONIN
+	/* Match the Wii U console's own beacon exactly (measured 2026-11-04 by
+	 * parsing hostapd's beacon hexdump against the decrypted real beacon in
+	 * capture/console-truth.pcap):
+	 *   HT capabilities info 0x001c  (greenfield-capable, 20 MHz, SMPS off,
+	 *                                 no short GI, no STBC, no LDPC)
+	 *   A-MPDU params        0x19    (16383 B max, 8 us minimum spacing)
+	 * The driver values we used to emit were 0x000c / 0x17, and the console's
+	 * greenfield bit was the visible difference. Barista carries the same fix
+	 * as third_party/hostapd-drc/patches/0007-hostapd-match-Wii-U-HT-advertisement.patch
+	 * and it is the only working implementation on current pad firmware.
+	 */
+	cap->ht_capabilities_info = host_to_le16(0x001c);
+	cap->a_mpdu_params = 0x19;
+#else /* CONFIG_TENDONIN */
 	cap->ht_capabilities_info = host_to_le16(hapd->iconf->ht_capab);
 	cap->a_mpdu_params = hapd->iface->current_mode->a_mpdu_params;
+#endif /* CONFIG_TENDONIN */
 	os_memcpy(cap->supported_mcs_set, hapd->iface->current_mode->mcs_set,
 		  16);
 
@@ -85,7 +101,14 @@ u8 * hostapd_eid_ht_operation(struct hostapd_data *hapd, u8 *eid)
 	os_memset(oper, 0, sizeof(*oper));
 
 	oper->control_chan = hapd->iconf->channel;
+#ifdef CONFIG_TENDONIN
+	/* The console's HT Operation carries RFIS permitted (ht_param bit 3) and a
+	 * zero operation-mode word; ours advertised neither. */
+	os_memset(&oper->operation_mode, 0, sizeof(oper->operation_mode));
+	oper->ht_param = HT_INFO_HT_PARAM_RIFS_MODE;
+#else /* CONFIG_TENDONIN */
 	oper->operation_mode = host_to_le16(hapd->iface->ht_op_mode);
+#endif /* CONFIG_TENDONIN */
 	if (hapd->iconf->secondary_channel == 1)
 		oper->ht_param |= HT_INFO_HT_PARAM_SECONDARY_CHNL_ABOVE |
 			HT_INFO_HT_PARAM_REC_TRANS_CHNL_WIDTH;
