diff --git a/libdrc-vnc/libdrc-thefloppydriver/include/drc/internal/idr-policy.h b/libdrc-vnc/libdrc-thefloppydriver/include/drc/internal/idr-policy.h
new file mode 100644
index 0000000..20141aa
--- /dev/null
+++ b/libdrc-vnc/libdrc-thefloppydriver/include/drc/internal/idr-policy.h
@@ -0,0 +1,127 @@
+// Keyframe (IDR) policy for the DRC link.
+//
+// The problem this solves, measured: the GamePad sends a 4-byte datagram
+// 01 00 00 00 once per frame EVEN WHEN THE PICTURE IS PERFECT - it is a
+// heartbeat, not a fault signal (wozt/libdrc 291aed6a8c noted 58/s while a
+// synthetic demo decoded cleanly). libdrc treats every one as "send me a
+// keyframe", so each frame becomes an IDR.
+//
+// Cost, measured on this host (research/CODEC-SPEC.md 2.2):
+//   normal desktop stream ...... 0.29 Mbps
+//   every frame an IDR ......... 8.57 Mbps   (17.8 kB/frame, 28x)
+// That cannot fit the link, so the pad loses more, asks more, and the picture
+// never recovers. The loop is broken by treating the message as liveness.
+//
+// Policy implemented here:
+//   * IDR on the first frame of a stream;
+//   * a proactive IDR every kProactiveIdrFrames frames (bounded self-healing);
+//   * a request-driven IDR only when the request cadence CHANGES - i.e. it
+//     arrives while the previous request was a long time ago - which is what a
+//     real "I lost the picture" request looks like;
+//   * one format-only slot after every IDR, so no P frame is sent while the
+//     receiver is still recovering (console behaviour: format+IDR, format only,
+//     format+P => a 2 x 16.683 ms IDR-to-P step).
+//
+// Pure code, no clocks: callers pass timestamps. tests/scheduler_test.cpp runs it.
+#ifndef DRC_INTERNAL_IDR_POLICY_H_
+#define DRC_INTERNAL_IDR_POLICY_H_
+
+#include <drc/types.h>
+
+namespace drc {
+
+// Proactive IDR cadence. Barista uses 60 encoded frames; a 60-frame cadence
+// costs ~1 fps and one ~40 kB IDR per second on game content.
+const u32 kProactiveIdrFrames = 60;
+
+// A heartbeat arriving sooner than this after the previous one is cadence, not
+// distress. At 59.94 fps a heartbeat lands every ~16.7 ms.
+const u32 kRequestDebounceUs = 50000;  // 50 ms ~= 3 frames
+
+// Hard ceiling on IDR frequency, measured against a decrypted real console
+// session (2026-11-04). A pad that cannot decode asks for a keyframe 45-60
+// times a second, and with only the 50 ms debounce above that still produced
+// 15.3 IDR/s - 3.29 Mbps, 9.59 datagrams/frame and the encoder stuck at 43 fps,
+// while the console's own stream to the same pad was 0.0 IDR/s, 1.67 Mbps,
+// 5.48 datagrams/frame at 57.9 fps and the pad stopped requesting entirely.
+// The console sends roughly one IDR per 26 s; Barista one per 60 frames (~1/s)
+// and works. So cap request-driven IDRs at 1/s: answering a request that fast
+// is pointless anyway, because an IDR takes longer than that to be useful.
+const u32 kMinIdrSpacingUs = 1000000;  // 1 s, env DRC_IDR_MIN_US overrides
+
+enum class IdrDecision {
+  kNone,        // send a normal P frame
+  kIdr,         // send an IDR frame
+  kFormatOnly,  // send only the 32-byte format message this slot
+};
+
+class IdrPolicy {
+ public:
+  IdrPolicy() {}
+  explicit IdrPolicy(u32 min_idr_spacing_us)
+      : min_idr_spacing_us_(min_idr_spacing_us) {}
+
+  // Returns what this frame slot should carry.
+  //   frame_index   frames encoded so far in this stream, starting at 0
+  //   requested     a 01 00 00 00 datagram arrived since the last call
+  //   now_us        caller's monotonic clock, microseconds
+  IdrDecision Decide(u64 frame_index, bool requested, u64 now_us) {
+    // Recovery slot: the frame right after an IDR carries only the format
+    // message, never video.
+    if (format_only_pending_) {
+      format_only_pending_ = false;
+      return IdrDecision::kFormatOnly;
+    }
+
+    const bool first = (frame_index == 0);
+    const bool proactive = frame_index != 0 &&
+                           (frame_index % kProactiveIdrFrames) == 0;
+
+    // Debounce: a request that repeats at heartbeat cadence is liveness.
+    bool real_request = false;
+    if (requested) {
+      if (!have_request_) {
+        real_request = true;
+      } else {
+        real_request = (now_us - last_request_us_) > kRequestDebounceUs;
+      }
+      last_request_us_ = now_us;
+      have_request_ = true;
+    }
+
+    // Rate ceiling. The first frame and the proactive cadence always go; a
+    // request-driven IDR has to clear the spacing on top of the debounce.
+    const bool spacing_ok =
+        !have_idr_ || (now_us - last_idr_us_) >= min_idr_spacing_us_;
+    if (first || proactive || (real_request && spacing_ok)) {
+      format_only_pending_ = true;
+      last_idr_us_ = now_us;
+      have_idr_ = true;
+      return IdrDecision::kIdr;
+    }
+    return IdrDecision::kNone;
+  }
+
+  // Frames still owed a recovery slot (0 or 1). For logging/tests.
+  bool format_only_pending() const { return format_only_pending_; }
+
+  void Reset() {
+    format_only_pending_ = false;
+    have_request_ = false;
+    have_idr_ = false;
+    last_idr_us_ = 0;
+    last_request_us_ = 0;
+  }
+
+ private:
+  bool format_only_pending_ = false;
+  bool have_request_ = false;
+  u64 last_request_us_ = 0;
+  bool have_idr_ = false;
+  u64 last_idr_us_ = 0;
+  u32 min_idr_spacing_us_ = kMinIdrSpacingUs;
+};
+
+}  // namespace drc
+
+#endif  // DRC_INTERNAL_IDR_POLICY_H_
diff --git a/libdrc-vnc/libdrc-thefloppydriver/include/drc/internal/session-push.h b/libdrc-vnc/libdrc-thefloppydriver/include/drc/internal/session-push.h
new file mode 100644
index 0000000..b3f8d9f
--- /dev/null
+++ b/libdrc-vnc/libdrc-thefloppydriver/include/drc/internal/session-push.h
@@ -0,0 +1,75 @@
+// Copyright (c) 2013, Mema Hacking, All rights reserved.
+// See LICENSE for the full license text.
+//
+// Replays the console's session-state push to the GamePad.
+//
+// Measured from a decrypted real console session (2026-11-04): the console's
+// dominant command traffic is 779 datagrams of svc 0 / method 0x11 - a 4-fragment
+// message stream (three `flags 0x42` continuations then one `flags 0x40` final,
+// tid 0x10b, a u32 index running 1..779) delivered at ~29 datagrams/s for the
+// first 28 s of a session, followed by svc 0/0x12 (whose payload contains the
+// count 0x0000030b = 779), svc 4/0x21 and svc 4/0x1a (flags 0x42).
+//
+// Nothing else in the corpus sends anything like it: it is ~4 KB/message,
+// ~240 kbit/s, and it exists only at session start. Our stack has never emitted
+// it from the streamer - only hand-replayed out-of-band - and the pad starts a
+// new session roughly every 80 s, so it has to be re-sent per session.
+//
+// The bytes come from the capture (out/evidence/truth/console-messages/
+// session-push.bin), replayed verbatim at the console's own cadence.
+#ifndef DRC_INTERNAL_SESSION_PUSH_H_
+#define DRC_INTERNAL_SESSION_PUSH_H_
+
+#include <atomic>
+#include <condition_variable>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <drc/types.h>
+
+namespace drc {
+
+class UdpClient;
+
+class SessionPusher {
+ public:
+  // dst_addr is the pad's "ip:port" for the command service (…:50123).
+  explicit SessionPusher(const std::string& dst_addr);
+  ~SessionPusher();
+
+  bool Start();
+  void Stop();
+
+  // Queue one replay of the console's session-start state push. Safe to call
+  // from any thread; a push already in flight is not restarted.
+  void Kick();
+
+  // Datagrams sent so far (for logging/tests).
+  u64 Sent() const { return sent_.load(); }
+
+ private:
+  void Loop();
+  bool Load();
+
+  std::unique_ptr<UdpClient> client_;
+  std::thread thread_;
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  std::atomic<bool> stop_{false};
+  std::atomic<bool> kick_{false};
+  std::atomic<u64> sent_{0};
+  bool running_ = false;
+
+  struct Record {
+    double rel;                 // seconds from the first datagram
+    std::vector<byte> payload;
+  };
+  std::vector<Record> records_;
+  bool loaded_ = false;
+};
+
+}  // namespace drc
+
+#endif  // DRC_INTERNAL_SESSION_PUSH_H_
